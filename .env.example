# TMDB → Settings → API → "API Read Access Token" (the long v4 token, not the short v3 key).
# Server-only: no VITE_ prefix, so it is never bundled into the browser JavaScript.
TMDB_TOKEN=paste_your_read_access_token_here

# ---- Neon Postgres (accounts, sync, cast cache, crowd recs) ----
# `neon deploy` / `neon env pull` writes these into .env.local for you.
# Pooled URL (host has -pooler): used by the running server.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct URL: used only by `npm run db:migrate`.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---- Better Auth (sign-in) ----
# Required when DATABASE_URL is set. Generate: openssl rand -base64 32
# Changing it signs everyone out.
BETTER_AUTH_SECRET=
# Public URL of the deployed app, e.g. https://vibe.example.com (optional locally).
# BETTER_AUTH_URL=
# Extra origins allowed to sign in / write (comma-separated), e.g. a separate web host.
# APP_ORIGINS=

# ---- Production server (npm start / Docker). All optional. ----
# PORT=3000
# Set when behind a load balancer/reverse proxy so rate limiting sees real client IPs (usually 1).
# TRUST_PROXY=1
# API_RATE_LIMIT_PER_MINUTE=300
# A "users like you" pattern needs this many distinct other users (privacy floor).
# CROWD_MIN_SUPPORT=3
