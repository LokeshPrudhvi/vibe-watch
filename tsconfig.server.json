{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "rootDir": "server",
    "outDir": "dist-server"
  },
  "include": ["server"],
  "exclude": ["server/**/*.test.ts"]
}
