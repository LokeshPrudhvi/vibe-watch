{
  "name": "vibe-watch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsc -p tsconfig.server.json && node --env-file-if-exists=.env --env-file-if-exists=.env.local dist-server/migrate.js"
  },
  "dependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8",
    "@tanstack/react-query": "^5.80.0",
    "better-auth": "^1.7.27",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "lucide-react": "^0.500.0",
    "motion": "^12.15.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@tailwindcss/vite": "^4.1.8",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.1.1"
  }
}
